# OnboardAI Environment Variables Template

# Application Environment
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=onboardai
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Storage Provider (local filesystem for dev)
STORAGE_LOCATION=./storage/documents

# AI Provider Configuration (Optional for real provider; fallback demo mode works automatically)
AI_PROVIDER=openai
AI_API_KEY=your_llm_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
